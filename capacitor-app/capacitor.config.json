{
  "appId": "com.optilifesync.app",
  "appName": "OptiLifeSync",
  "webDir": "www",
  "server": {
    "url": "https://opti-life-sync-v1-1.vercel.app/dashboard.php",
    "cleartext": false,
    "androidScheme": "https",
    "errorPath": "offline.html"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "launchAutoHide": true,
      "backgroundColor": "#0B1220",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    },
    "StatusBar": {
      "overlaysWebView": false,
      "style": "DARK",
      "backgroundColor": "#0B1220"
    }
  },
  "android": {
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": false
  }
}