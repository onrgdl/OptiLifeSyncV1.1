# ─────────────────────────────────────────────────────────────────────────────
# OptiLifeSync — Apache Güvenlik Kuralları
# ─────────────────────────────────────────────────────────────────────────────

# PHP hata çıktısını gizle (production modu)
php_flag display_errors Off

# ── Hassas Dosyalara Doğrudan Erişimi Engelle ───────────────────────────────
<FilesMatch "^(\.env|\.env\.example|\.gitignore|composer\.json|composer\.lock|package\.json|package-lock\.json)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# ── Hassas Dizinlere ve Dosyalara Erişimi Engelle ───────────────────────────
<IfModule mod_rewrite.c>
    RewriteEngine On

    # .git ve nokta ile başlayan tüm gizli dosya/dizinlere erişimi engelle
    RewriteRule (^|/)\. - [F,L]

    # Script, dokümantasyon, veritabanı ve log dosyalarını engelle
    RewriteRule \.(bat|md|sql|log|sh|ini)$ - [F,L]

    # config/ dizinini dışarıya kapat
    RewriteRule ^config/ - [F,L]

    # database/ dizinini dışarıya kapat
    RewriteRule ^database/ - [F,L]

    # app/ dizinini dışarıya kapat
    RewriteRule ^app/ - [F,L]

    # logs/ dizinini dışarıya kapat
    RewriteRule ^logs/ - [F,L]

    # Kurulum ve örnek kullanım dosyalarına webden erişimi engelle
    RewriteRule ^(setup|setup_supabase|example_usage)\.php$ - [F,L]
</IfModule>

# ── Dizin Listelemeyi Kapat ───────────────────────────────────────────────────
Options -Indexes

# ── Güvenlik Başlıkları (Security Headers) ────────────────────────────────────
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
