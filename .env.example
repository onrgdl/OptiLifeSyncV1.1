# =====================================================================
# OptiLifeSync - Ortam Değişkenleri Yapılandırması (.env)
# =====================================================================

# ─────────────────────────────────────────────────────────────────────
# 1. BULUT VERİTABANI (SUPABASE POSTGRESQL & VERCEL İÇİN)
# ─────────────────────────────────────────────────────────────────────
# Supabase Dashboard -> Project Settings -> Database -> Connection string
# Vercel üzerinde Settings -> Environment Variables altına ekleyin:
#
# ÖNERİLEN (Transaction Pooler - Port 6543):
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require

# Alternatif (Direct Connection - Port 5432):
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require

# Sürücü Seçimi (DATABASE_URL girildiğinde otomatik belirlenir):
# DB_DRIVER=pgsql

# ─────────────────────────────────────────────────────────────────────
# 2. YEREL GELİŞTİRME VERİTABANI (XAMPP / MYSQL)
# ─────────────────────────────────────────────────────────────────────
# DATABASE_URL boş ise bu yerel ayarlar geçerli olur:
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=gyp_db
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# ─────────────────────────────────────────────────────────────────────
# 3. GEMINI AI API (YAPAY ZEKA BESİN & GÖRSEL ANALİZİ)
# ─────────────────────────────────────────────────────────────────────
# Google AI Studio'dan ücretsiz alabilirsiniz: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=BURAYA_GEMINI_API_KEY_YAZIN
GEMINI_MODEL=gemini-2.5-flash-lite

# ─────────────────────────────────────────────────────────────────────
# 4. UYGULAMA GENEL AYARLARI
# ─────────────────────────────────────────────────────────────────────
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=Europe/Istanbul
